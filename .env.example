# Bazaar Brain — environment template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Firebase (auth only, Phase 0) -------------------------------------------
# These are Firebase web-SDK config values, not secrets; they are safe to
# expose in the client bundle. Get them from Firebase console → Project
# settings → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Groq (AI forecasts) -----------------------------------------------------
# Free key: console.groq.com → API Keys. Value must start with gsk_ — no quotes.
# NOTE: the key stays in the client bundle for now (Phase 0). FIX-2 moves this
# call behind a Supabase Edge Function; after that, delete this value.
VITE_GROQ_API_KEY=

# Optional. Overrides the default Groq model. Groq occasionally retires models
# (llama-3.3-70b-versatile → 404), so if forecasts fail with a model error,
# check the current model list at console.groq.com and set the new id here.
# Default: openai/gpt-oss-120b
# VITE_GROQ_MODEL=

# Optional. When set, forecast requests are sent to this URL (e.g. a Supabase
# Edge Function proxy) instead of Groq directly, and the browser no longer
# needs the Groq key. Used by FIX-2 (Phase 1+).
# VITE_FORECAST_URL=
