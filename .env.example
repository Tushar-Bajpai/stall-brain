# Bazaar Brain — environment template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Firebase (auth only, Phase 0) -------------------------------------------
# These are Firebase web-SDK config values, not secrets; they are safe to
# expose in the client bundle. Get them from Firebase console → Project
# settings → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Groq (AI forecasts) -----------------------------------------------------
# IMPORTANT (Phase 1, free plan): the deployed app calls forecasts through the
# Vercel function `api/forecast.js`, which reads GROQ_API_KEY from VERCEL env
# vars (Project → Settings → Environment Variables). The VITE_ key below is the
# LOCAL-DEV-ONLY fallback (used when VITE_FORECAST_URL is not set) and should be
# empty in production deploys.
VITE_GROQ_API_KEY=

# Optional. Overrides the default Groq model. Groq occasionally retires models
# (llama-3.3-70b-versatile → 404), so if forecasts fail with a model error,
# check the current model list at console.groq.com and set the new id here.
# Default: openai/gpt-oss-120b
# VITE_GROQ_MODEL=

# Route of the forecast proxy. In production (Vercel) set this to /api/forecast
# (no key in the bundle; the browser authenticates with its Firebase ID token).
# For local dev you can leave it unset (direct Groq call with VITE_GROQ_API_KEY)
# or run `vercel dev` and set it to /api/forecast as well.
VITE_FORECAST_URL=
